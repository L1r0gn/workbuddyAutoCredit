{
  "name": "workbuddy-auto-checkin",
  "version": "1.0.0",
  "private": true,
  "description": "WorkBuddy 每日积分自动签到（本地凭据 + 官方接口，独立实现）",
  "main": "dist/checkin/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "checkin:status": "node dist/checkin/cli.js status",
    "checkin:run": "node dist/checkin/cli.js run",
    "checkin:all": "node dist/checkin/cli.js all",
    "checkin:dry-run": "node dist/checkin/cli.js dry-run",
    "checkin:daemon": "node dist/checkin/cli.js daemon",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:only": "node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
