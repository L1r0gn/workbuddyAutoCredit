# ===== Qoder 账号（不要提交真实令牌）=====
# 国内版（Qoder CN）：每行一个账号，支持三种写法
#   access_token
#   access_token|refresh_token
#   备注|access_token|refresh_token
# 多个账号用换行或 & 分隔。
QODER_TOKENS=

# 国际版（Qoder）：同上，第 4 段可选填 uid
#   备注|access_token|refresh_token|uid
QODER_GLOBAL_TOKENS=

# ===== 设备身份（可选）=====
# 正常情况下不需要配置：程序会自动找对应客户端的官方 runtime-info 组件。
# 自定义安装路径时，用下面的变量指向组件本体：
#   Windows 例：C:/Qoder CN/resources/umid/runtime-info.exe
#   macOS   例：/Applications/Qoder.app/Contents/Resources/umid/runtime-info
QODERCN_RUNTIME_INFO=
QODER_RUNTIME_INFO=
# 通用覆盖（两个区域共用，不推荐；会导致区域串用）
QODER_UMID_PATH=

# ===== 客户端可执行文件（可选，用于读取版本号与定位组件）=====
# 装在非默认目录时建议填写
# QODER_CN_EXE=C:/Qoder CN/Qoder CN.exe
# QODER_GLOBAL_EXE=C:/Qoder/Qoder.exe

# ===== 登录辅助（可选）=====
# 置 1 则不尝试自动唤起浏览器，只打印授权链接（适合远程/无图形环境）
# QODER_LOGIN_NO_BROWSER=1

# ===== 数据与配置（可选）=====
# 默认 %APPDATA%\workbuddy-auto-checkin
# QODER_CHECKIN_DATA_DIR=
# QODER_CHECKIN_CONFIG=
